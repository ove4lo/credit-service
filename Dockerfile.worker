# Multi-stage build
FROM golang:1.25 AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /worker ./cmd/worker

# Final image
FROM alpine:latest
COPY --from=builder /worker /worker
CMD ["/worker"]
# NOTE: without EXPOSE, because the worker doesn't listen on an HTTP port - it listens to the queue